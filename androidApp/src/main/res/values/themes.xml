<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="Theme.Ehya" parent="android:Theme.Material.NoActionBar">
    <item name="android:windowBackground">@color/black_olive</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>

  <!-- System splash screen (androidx.core:core-splashscreen), hands over to Theme.Ehya. -->
  <style name="Theme.Ehya.Starting" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/black_olive</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    <item name="postSplashScreenTheme">@style/Theme.Ehya</item>
  </style>
</resources>
